{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.bchoi-qwe/aeso-mcp",
  "title": "AESO MCP",
  "description": "Typed Alberta electricity market data and analytics via official AESO APIs.",
  "repository": {
    "url": "https://github.com/bchoi-qwe/aeso-mcp",
    "source": "github"
  },
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "aeso-mcp",
      "version": "0.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "AESO_API_KEY",
          "description": "AESO APIM subscription key",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
