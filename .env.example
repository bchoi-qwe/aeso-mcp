# Environment variables for AESO MCP
# Copy to .env and fill in values. Never commit real secrets.

# Required: AESO APIM subscription key from https://developer-apim.aeso.ca/
AESO_API_KEY=your-aeso-api-key-here

# Optional logging level: CRITICAL, ERROR, WARNING, INFO, DEBUG
AESO_MCP_LOG_LEVEL=INFO

# Optional HTTP timeouts (seconds)
# AESO_MCP_HTTP_CONNECT_TIMEOUT_S=10
# AESO_MCP_HTTP_READ_TIMEOUT_S=60
# AESO_MCP_HTTP_MAX_RETRIES=3

# Optional remote HTTP protections. The HTTP transport always validates Host
# and Origin headers, limits request rates/concurrency/body size, and leaves
# /healthz and /readyz available without a bearer token.
# AESO_MCP_HTTP_BEARER_TOKEN=replace-with-a-long-random-token
# Non-loopback HTTP binds require the bearer token above unless this explicit override is true.
# AESO_MCP_HTTP_ALLOW_INSECURE_REMOTE=false
# AESO_MCP_HTTP_ALLOWED_ORIGINS=https://client.example.com
# AESO_MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1
# AESO_MCP_HTTP_RATE_LIMIT_REQUESTS=120
# AESO_MCP_HTTP_RATE_LIMIT_WINDOW_S=60
# AESO_MCP_HTTP_MAX_CONCURRENT_REQUESTS=32
# AESO_MCP_HTTP_MAX_REQUEST_BODY_BYTES=1048576

# Optional local DuckDB/Parquet root (requires installation with aeso-mcp[analytics])
# AESO_MCP_HISTORY_STORE_PATH=~/.cache/aeso-mcp/history
